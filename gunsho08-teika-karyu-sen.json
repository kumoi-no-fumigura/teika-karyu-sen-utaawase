 "poems": [
  {
   "seq": "1",
   "text": "ふみしたく淺香の沼のした草にかつみたれ行忍ふもちすり",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "あしかもの跡も定めぬみつのえに猶すみかたき春や行みむ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "なきぬめり夕つけ鳥のしたり尾のをのれにも似ぬよはの短さ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "秋はいまたとほ山鳥のしたり尾のあまりておしき有明の月",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "芦のやのかりねの床のふしのまもみしかく明る夏のよな〓〓",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "みしまえのにほのうきすも亂れ蘆の末葉にかゝる五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "打なひくしけみかしたのさゆり葉のしられぬ程に通ふ秋風",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "むは玉の闇のうつゝのうかひ舟つきのさかりや夢にみるへき",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "秋とたに吹あへぬかせに色かはるいく田の森の露の下草",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "軒ちかき山下荻の聲たてゝ夕日かくれに秋かせそふく",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "須磨の海士のなれにし袖もしほたれて關吹こゆる秋の浦かせ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "秋かせに山のは渡る村雨をことそともなく出る月かけ",
   "kana": "",
   "speaker": "",
   "page": 514,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "なをさりの小野の淺茅にをく露の草葉に餘る秋の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "花もはもしろく成行萩かえに村雨かゝる秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "小倉山しくるゝ比のあさな〓〓昨日は薄きよものもみら葉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "秋風はさてもや物のかなしきと荻の葉ならぬ夕暮も哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "淺茅生の小野の篠原打なひき遠方人に秋かせそ吹",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "露はらふ袖吹がへす秋かせにうらさへ萩の色そ移ふ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "秋はいぬ夕日かくれの嶺の松よもの木のはの後もあひみん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "神代より小倉の山のもみち葉はしたてる姫や染はしめ釼",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "うつりあへぬ色の千種にみたれつゝかせの上なる宮城のゝ露",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "又やみむまたやみさらん白露の玉をきしける秋はぎの花",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "花すゝき草の袂もくちはてぬ馴て別し秋をこふとて",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "草のはにくらせる宵のきり〓〓す秋風ふけぬせむかたやなき",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "詠つゝおもひしものをかす〓〓にむなしき空に秋夜月",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "くれぬまに山のは遠く成てけり空より出る秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "浦かせやとはに浪こす濵松のねにあらはれて啼千鳥哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "よや寒き里は雲井のこからしに聲さへうすく衣うつん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "昔たに猶故〓の秋の月しらすひかりのいくめくりとも",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "有明の月のかつらのもみち葉を嶺に殘してを鹿鳴え",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "志賀の浦や氷も幾重いるたつの霜のさはまに雪そ降つゝ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "あしへ行鴨のはかひの夕霜をよそにもながぬ小夜干鳥哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "川かせによわたる月の寒けれはやそうち人も衣うつん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "ふけあらし雲の衣のきぬ〓〓は月におしまぬ有明の空",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "雪おれの竹の下道跡もなしあれにし後の深草の里",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "かへるとも雲の衣はうらもあらし一夜夢かせ嶺のこからし",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "伊駒山あらしも秋の色に吹手そめのいとのよるそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "朝ひさす高れのみ雪雲晴てたちもおよはぬ富士の川きり",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "小初瀨や嶺のときは木吹しほりあらしに曇る雪のやまさと",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "さえのほるこしのしらねは冬の月雪のこほりも麓成けり",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "高砂の外にも秋はあるものを我夕くれと鹿はなくえ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "天川あきの一夜の契たにかたのに鹿のねをや鳴らん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "高砂の尾上の鹿のなかぬ日も積りはてぬる松のしら雪",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "白妙のたなひく雲を吹分て雪にあまきる嶺の松かせ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "夕つくひむかひの岡の薄紅葉またきさひしき秋の色哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "さをしかのよはの草ふしあれぬれど歸る山なき武藏野の原",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "しられしな千入の木のは焦るともしくるゝ雲に色しみえねは",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "霜かゝる人の心のあさは野にたつみはこすけねさへくちめや",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "逢みての後の心をまつしれはつれなしと社えこそうらみね",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "なき名のみ少つけ島の相坂にすてられてのみれなもなかはや",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "露時雨した草かけてもる山に色かすならぬ袖をみせはや",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "なきこふる袖にはいかゝ宿すべき曇りならはぬ秋の夜の月",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "俤はをしへし宿に先立てこたえぬかせの松に吹こゑ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "曇れけふ入相の鐘も程遠したのめてかへる春の曙",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "よとゝもに吹上の演の鹽風になひく眞砂のくたけてそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "時過て小野の淺茅生立煙しりぬや今は思ひ有とも",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "住のえの松のねたくやよる浪のよるとて歎く夢をたにみて",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "床は海まくらは山となりぬへし涙もちりも積るうらみに",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "芦のやに螢やまかふ海士やたくおもひも戀もよるはもえつゝ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "我戀はまた末遠しはし鷹のよるさへやすくいやはねられぬ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "白玉のをたえの橋の名もつらしくたけて落る袖の泪に",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "永きひのすかのあら野にかる草のゆふてもたゆくとけぬ君哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "忘れすはなれし袖もやこほるらむねぬよの床の霜のさむしろ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "おもひ川影みし水の薄氷がさなるよはの月もうらめし",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "こめ人をまつほの浦の夕なきにやくやもしほの身も焦れつゝ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "山川の紅葉にましる水の淡の色にいてゝもぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "誰もこのあはれみしかき玉のをの亂れて物を思はすも哉",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "千早振神のみむろのます鏡かけていくよのかけをみるらん",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "心をはつらき物とて別にしよはの俤なにしたふらむ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "つくは山□もあけぬ吹かせに人の心のひまそつれなき",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "よもすから月にうれへてねをそなく命にむかふ物思ふとて",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "なく涙やしほの泪それなから馴すは何の色かしのはむ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "人心何につなかむ色變るまさきのつなのよるもたまらす",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "せめて思ふいま一度の逢事はわたらむ川や契りなるへき",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "床はあれぬいたくな吹そ秋のかせめにみぬ人を夢にたにみむ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "命たにあらは逢よをまつら川かへらぬ浪もよとめとそおもふ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "はきの葉に末吹なひく秋風にたまらぬ露のくたけてそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "やすらひに出ける方も白鳥のとは山松のねにのみそなく",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "忘れかひそれも思ひのたね絕て人をみぬめのうらみてそぬる",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "おもひ川まれなる中になかるここれにも渡せかさゝきの橋",
   "kana": "",
   "speaker": "",
   "page": 515,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "世中を思ひのきはの忍ふ草いくよの宿とあれかはてけむ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "谷川の朽木の橋の埋木も人にじられぬ道や絕なむ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "明るよの夕つけ鳥に立別れうらなみ遠く出る舟人",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "興津浪よする磯へのうき枕遠さかるなり鹽のみつらむ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "わかの浦やなきたるあまの澪標精ねかひなき名たに殘らて",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "春日山おとろの道も中絕てみをうちはしの秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "おもふ事むなしき夢の中絕にたゆともたゆなつらき玉の〓",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "おきなさひ人なとかめそこのうちに昔をこふる露の毛衣",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "眞木の戶をあけて夜深き梅かゝに春のねさめをとふ人もかな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "霞む日もくれはとくとやまたれましとをちの里の昔なりせは",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "今はとて風吹山のさくら花うしといひても春をみるかな",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "をのか身の翅にかける玉章をやらてもみはや春のかりかね",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "おもひ川いかれる比の五月雨にせいても水の淵となるらん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "咲ぬれはかならす花のおりにとも賴めぬ人のまたれける哉",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "草の葉の露も我身の上なれは袖のみほさぬ秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "今こそは聲たてゝなけ子規忍ひあまるや夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "露しけき庭の淺茅生我ならぬ思ひもありと虫の鳴らん",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "おりたちて鹿はなけとも澤水の淺き心をつまや賴まむ",
   "kana": "",
   "speaker": "",
   "page": 516,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
